# REST API base. The AI chat (MCP) origin is derived from this automatically:
#   bug:     https://bug-api.swiftpro.tech/api/v1/dev
#   staging: https://dev.swiftpro.tech/api/v1/dev
#   prod:    https://api.swiftpro.tech/api/v1/dev
VITE_API_BASE_URL=https://dev.swiftpro.tech/api/v1/dev

# Optional override for the AI chat (MCP) origin. Leave unset to reuse the
# VITE_API_BASE_URL host (the default); set only if chat moves off the API host.
# VITE_MCP_BASE_URL=https://dev.swiftpro.tech

# Yjs collaboration WebSocket server (used by the collab editor + versions).
VITE_WS_URL=wss://api.swiftpro.tech/api/v1/dev/contract

# Origin of the AGPL SuperDoc editor app embedded in the collaboration tool.
# Matched pair with the editor app's VITE_HOST_ORIGIN. A missing value in a
# production build is fatal (see collab/superdocBridge.ts resolveSuperdocAppUrl).
#   dev:  http://localhost:5174
#   prod: https://editor.swiftpro.tech
VITE_SUPERDOC_APP_URL=http://localhost:5174

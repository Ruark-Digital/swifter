{"version":3,"file":"index.js","sources":["../src/createSelectorFunctions.ts","../src/createSelectorHooks.ts"],"sourcesContent":["import { type StoreApi, type UseBoundStore, useStore } from 'zustand';\n\nexport interface ZustandFuncSelectors<StateType> {\n  use: {\n    [key in keyof StateType]: () => StateType[key];\n  };\n}\n\nexport function createSelectorFunctions<StateType extends object>(\n  store: UseBoundStore<StoreApi<StateType>> | StoreApi<StateType>\n) {\n  const storeIn = store as any;\n\n  storeIn.use = {};\n\n  Object.keys(storeIn.getState()).forEach((key) => {\n    const selector = (state: StateType) => state[key as keyof StateType];\n    storeIn.use[key] = typeof storeIn === 'function'\n      ? () => storeIn(selector)\n      : () => useStore(storeIn, selector as any);\n  });\n\n  return store as UseBoundStore<StoreApi<StateType>> &\n    ZustandFuncSelectors<StateType>;\n}\n","import { type StoreApi, type UseBoundStore, useStore } from 'zustand';\n\nexport type ZustandHookSelectors<StateType> = {\n  [Key in keyof StateType as `use${Capitalize<\n    string & Key\n  >}`]: () => StateType[Key];\n};\n\nconst capitalize = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);\n\nexport function createSelectorHooks<StateType extends object>(\n  store: UseBoundStore<StoreApi<StateType>> | StoreApi<StateType>\n) {\n  const storeIn = store as any;\n\n  Object.keys(storeIn.getState()).forEach((key) => {\n    const selector = (state: StateType) => state[key as keyof StateType];\n    storeIn[`use${capitalize(key)}`] = typeof storeIn === 'function'\n      ? () => storeIn(selector)\n      : () => useStore(storeIn, selector as any);\n  });\n\n  return storeIn as UseBoundStore<StoreApi<StateType>> &\n    ZustandHookSelectors<StateType>;\n}\n"],"names":["useStore"],"mappings":";;;;AAQM,SAAU,uBAAuB,CACrC,KAA+D,EAAA;IAE/D,IAAM,OAAO,GAAG,KAAY,CAAC;AAE7B,IAAA,OAAO,CAAC,GAAG,GAAG,EAAE,CAAC;AAEjB,IAAA,MAAM,CAAC,IAAI,CAAC,OAAO,CAAC,QAAQ,EAAE,CAAC,CAAC,OAAO,CAAC,UAAC,GAAG,EAAA